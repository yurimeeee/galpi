rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Page photos live under users/{uid}/sentence-photos and are only ever
    // readable/writable by that same signed-in user.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
